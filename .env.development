VITE_API_URL=
API_PROXY_TARGET=http://localhost:8081

# Firebase Auth: locally the emulator from the API's docker-compose (make up / make infra),
# reached through the Vite proxy (FIREBASE_AUTH_EMULATOR_TARGET), so it also works from a phone.
# In production, use the web app config from the Firebase console and leave the emulator off.
VITE_FIREBASE_API_KEY=demo-key
VITE_FIREBASE_AUTH_DOMAIN=demo-entregador.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=demo-entregador
VITE_FIREBASE_AUTH_EMULATOR=true
FIREBASE_AUTH_EMULATOR_TARGET=http://localhost:9099
